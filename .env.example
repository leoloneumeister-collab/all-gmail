# Google OAuth client (Desktop app type). See README, step 1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional
# PORT=8787
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_FALLBACKS=0            # set 0 to turn off server-side refusal fallbacks
# ALL_GMAIL_MCP_ALLOW_SEND=1    # lets Claude Desktop/Code send mail through the MCP server (off by default)
